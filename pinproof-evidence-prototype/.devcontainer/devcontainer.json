{
    "name": "pinproof-evidence-prototype",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12"
        }
    },
    "postCreateCommand": "pip install -e \".[dev]\" && echo 'PinProof ready. Try: pinproof scan --config fixtures/good/pinproof.yaml'",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ]
        }
    },
    "remoteEnv": {
        "PYTHONUNBUFFERED": "1"
    }
}
